# spark-job built from main commit 60affe8 (B2: catalog_tool tag/verify-tag; images run 42579777978;
# previous 7fd88ec = sha256:05ff7b97…9eb2; the d28cf2b rebuild had identical inputs and was not promoted)
SPARK_JOB_IMAGE_REF=ghcr.io/beno1tp/vnpt-lake-spark-job@sha256:130a2b2f48e6e5b1ad117c1932aa50ac29933720946acc4fab0217e2dee2ca2f
