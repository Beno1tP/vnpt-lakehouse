# spark-job built from main commit 12eb6ed (Task 4 4.0a: step in Silver, schema evolution; images run 42778808527;
# previous f64b790 = sha256:e7ab260b…fb1e)
SPARK_JOB_IMAGE_REF=ghcr.io/beno1tp/vnpt-lake-spark-job@sha256:3da7f249772e47c700a972b331eff50314e90230c429a1d924d4debaeff064c4
