# Images deployed on Minikube (step 2.0c, D5): built by .github/workflows/images.yml, pulled from GHCR by digest.
# Update after an images run: copy the digests from the run summary, open a PR. CI checks that
# infra/k8s/kustomization.yaml (images:) uses the same digests (tests/unit/test_manifests.py).
# Read by the Makefile (SparkApplications, landing pod); kustomize has its own copy for HMS and bucket-init.
SPARK_IMAGE_REF=ghcr.io/beno1tp/vnpt-lake-spark@sha256:aee0deb990471c57e37936f10aa6f91880ef7cff3713e09a4cc974d5bb0cad5c
HMS_IMAGE_REF=ghcr.io/beno1tp/vnpt-lake-hms@sha256:9446f7d1e0ab211f1fe32b0f8def318699e6afa40a5e1fcebfa3d07d134b91ff
# spark-job built from main commit 7fd88ec (ruff format only, no logic change; images run 40360779190;
# previous 37b5dfa = sha256:d9e2fe94…02fc)
SPARK_JOB_IMAGE_REF=ghcr.io/beno1tp/vnpt-lake-spark-job@sha256:05ff7b9769da5f6251aae6d6990e14ba7f5d8db6136901d6d6b2e67fc94f9eb2
# airflow = apache/airflow:3.3.2-python3.12 + dags/ + plugins/, built from main commit c0babb5 (hello_lake removed;
