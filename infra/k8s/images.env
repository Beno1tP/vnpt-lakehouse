HMS_IMAGE_REF=ghcr.io/beno1tp/vnpt-lake-hms@sha256:9446f7d1e0ab211f1fe32b0f8def318699e6afa40a5e1fcebfa3d07d134b91ff
# spark-job built from main commit 041717a00d6e8b3f02441ae1abef02a0ba975f29 (jobs/ + tests/expected + tests/sql)
SPARK_JOB_IMAGE_REF=ghcr.io/beno1tp/vnpt-lake-spark-job@sha256:2e5f830e77909704c010d9e33335ab418f82c86b229041750bda7737ae9ca243
