# Task 2 credentials. Copy to infra/k8s/secrets.env (git-ignored) and change every password.
# Render the K8s secret files with: make k8s-secrets   (writes infra/k8s/secrets/, git-ignored, mode 600)
PG_USER=hive
PG_PASSWORD=change-me-pg
AIRFLOW_DB_PASSWORD=change-me-airflow-db
MINIO_ROOT_USER=minioadmin_lab
MINIO_ROOT_PASSWORD=change-me-minio
# Airflow UI user 'admin' (step 2.3). The renderer adds AIRFLOW_FERNET_KEY, AIRFLOW_API_SECRET_KEY and
# AIRFLOW_JWT_SECRET to secrets.env on its first run (random, kept stable afterwards).
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-admin
