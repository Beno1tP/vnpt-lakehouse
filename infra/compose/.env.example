# Copy to .env (git-ignored) and change the passwords.
# MinIO: official images were removed from Docker Hub/quay.io (2026). Chainguard rebuild of the MinIO server.
# After the first successful pull, pin the digest: MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:<digest>
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
AWSCLI_IMAGE=amazon/aws-cli:latest
MINIO_ROOT_USER=minioadmin_lab
MINIO_ROOT_PASSWORD=change-me-please

PG_USER=hive
PG_PASSWORD=change-me-too
PG_JDBC_VERSION=42.7.4

HIVE_IMAGE=apache/hive:4.0.1
# Verified 2026-10-16: apache/hive:4.0.1 ships hadoop-common-3.3.6
HADOOP_AWS_VERSION=3.3.6
# The aws-java-sdk-bundle version that hadoop-aws 3.3.6 depends on
AWS_SDK_BUNDLE_VERSION=1.12.367

# Verified pull 2026-10-16
SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu
ICEBERG_VERSION=1.11.0

# Folder with the 2 Excel files (WSL filesystem)
RAW_DATA_DIR=/home/user/data/vnpt-lab
