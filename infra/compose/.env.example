# Copy to .env (git-ignored) and change the passwords.
# Base images pulled by digest; 2 thin runtime images built from docker/ (make build).
# MinIO: official images were removed from Docker Hub/quay.io (E01) -> Chainguard rebuild of the MinIO server.
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:2136d593beacf4461187035eca949fe49abd589d5079735025c711ca58fee0c8
AWSCLI_IMAGE=amazon/aws-cli@sha256:733d5be1015825e4038c6016f3fa9954868ddee1f611b73be795a9cc2e706bfd
MINIO_ROOT_USER=minioadmin_lab
MINIO_ROOT_PASSWORD=change-me-please

PG_USER=hive
PG_PASSWORD=change-me-too

# Folder with the 2 Excel files (WSL filesystem; check with: whoami)
RAW_DATA_DIR=/home/quang/data/vnpt-lab

# Base images (pinned by digest; versions + jar checksums live in docker/*/Dockerfile)
SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu@sha256:f3d6eaa8bab8ec2e38f3c3918a5b2f8b253c95bcb19f9e87ad0e0cdacf9df2d5
HIVE_IMAGE=apache/hive:3.1.3@sha256:d102ba29ad07e93c303894896203a80b903c0001d80221f1cb9fea92dcac06e4
POSTGRES_IMAGE=postgres:16@sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54
BUSYBOX_IMAGE=busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
# Thin runtime images built by: make build
SPARK_RUNTIME_IMAGE=vnpt-lake-spark:3.5.9-iceberg1.11.0-r1
HMS_RUNTIME_IMAGE=vnpt-lake-hms:3.1.3-hadoopaws3.1.0-r1
