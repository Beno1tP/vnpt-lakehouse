# Copy to .env (git-ignored) and change the passwords.
# Images are pulled, never built. Pinned by digest where the tag is moving (verified 2026-10-16).
# MinIO: official images were removed from Docker Hub/quay.io (E01) -> Chainguard rebuild of the MinIO server.
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:2136d593beacf4461187035eca949fe49abd589d5079735025c711ca58fee0c8
AWSCLI_IMAGE=amazon/aws-cli@sha256:733d5be1015825e4038c6016f3fa9954868ddee1f611b73be795a9cc2e706bfd
CURL_IMAGE=curlimages/curl:8.22.0
MINIO_ROOT_USER=minioadmin_lab
MINIO_ROOT_PASSWORD=change-me-please

PG_USER=hive
PG_PASSWORD=change-me-too
PG_JDBC_VERSION=42.7.4

# HMS 3.x: Spark 3.5's Hive 2.3 client cannot talk to HMS 4 (E16)
HIVE_IMAGE=apache/hive:3.1.3
# MUST equal the image's hadoop-common (apache/hive:3.1.3 -> 3.1.0); 3.1.3 needs Guava 27 (E17)
HADOOP_AWS_VERSION=3.1.0
# The aws-java-sdk-bundle that hadoop-aws 3.1.0 was built with (hadoop-project-3.1.0.pom)
AWS_SDK_BUNDLE_VERSION=1.11.271

# Ships Python 3.10.12, Java 17
SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu
ICEBERG_VERSION=1.11.0

# Folder with the 2 Excel files (WSL filesystem; check with: whoami)
RAW_DATA_DIR=/home/quang/data/vnpt-lab
