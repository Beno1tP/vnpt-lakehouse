# Copy to .env (git-ignored) and change the passwords.
# Pin MinIO tags you can actually pull (MinIO changed its community distribution in 2025).
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=minioadmin_lab
MINIO_ROOT_PASSWORD=change-me-please

PG_USER=hive
PG_PASSWORD=change-me-too
PG_JDBC_VERSION=42.7.4

HIVE_IMAGE=apache/hive:4.0.1
# Must equal Hive's bundled hadoop-common version (check inside the container)
HADOOP_AWS_VERSION=3.3.6
# The aws-java-sdk-bundle version that hadoop-aws 3.3.6 depends on
AWS_SDK_BUNDLE_VERSION=1.12.367

SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu
ICEBERG_VERSION=1.11.0

# Folder with the 2 Excel files. Run make from a WSL (Ubuntu) terminal; keep data in the WSL filesystem for speed
RAW_DATA_DIR=/home/CHANGE_ME/data/vnpt-lab
